
# ──────────────────────────────────────────────────────────────────────────────
# UniFi Log Insight — Environment Variables
# Copy this file to .env and fill in the required values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Encryption key for stored API keys (AbuseIPDB, UniFi, MaxMind).
# For embedded DB setups, POSTGRES_PASSWORD serves this role automatically.
# For external DB setups, set SECRET_KEY instead (clearer and avoids confusion).
# Changing this after setup will require re-entering API keys in the UI.
# SECRET_KEY=your_secret_here

# PostgreSQL password for the embedded 'unifi' database user.
# Also used as encryption key if SECRET_KEY is not set.
POSTGRES_PASSWORD=changeme

# ── External Database (Optional) ─────────────────────────────────────────────
# Point at an existing PostgreSQL 14+ instance instead of the embedded one.
# When DB_HOST is set to a non-localhost address, the embedded PostgreSQL is
# disabled automatically. Set SECRET_KEY (or keep POSTGRES_PASSWORD) for encryption.

# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=unifi_logs
# DB_USER=unifi
# DB_PASSWORD=your_db_password
# DB_SSLMODE=require

# TLS certificate paths (for verify-ca / verify-full modes or mTLS):
# DB_SSLROOTCERT=/path/to/ca-certificate.crt
# DB_SSLCERT=/path/to/client-cert.crt
# DB_SSLKEY=/path/to/client-key.key

# ── Connection Pool (Optional) ────────────────────────────────────────────────
# Sizes for the psycopg2 connection pools. Defaults are conservative; raise
# DB_POOL_MAX for high-concurrency deployments — especially behind PgBouncer in
# session mode, where each pooled connection holds one server connection.
# The receiver and API each use DB_POOL_MIN/DB_POOL_MAX; the IP-enrichment
# worker uses the smaller DB_ENRICHER_POOL_* pool.

# DB_POOL_MIN=2
# DB_POOL_MAX=10
# DB_ENRICHER_POOL_MIN=1
# DB_ENRICHER_POOL_MAX=3

# Seconds to wait when establishing a PostgreSQL connection.
# DB_CONNECT_TIMEOUT=10

# ── Timezone ──────────────────────────────────────────────────────────────────

# Must match your UniFi gateway's local time for correct syslog timestamps.
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=UTC

# ── Retention ─────────────────────────────────────────────────────────────────

# Time of day (HH:MM, 00:00–23:59, container-local time) when the daily
# retention cleanup runs. Minute precision is supported. Optional; overridden
# by the Settings UI if a value is saved there. Default: 03:00.
# RETENTION_CLEANUP_TIME=03:00

# DEPRECATED (v3.6.3): v3.6.2 shipped this as RETENTION_TIME. The old name is
# still honoured for backward compatibility but logs a WARNING on boot and
# will be removed in a future release — rename to RETENTION_CLEANUP_TIME above.

# ── Logging ───────────────────────────────────────────────────────────────────

# Verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# ── AbuseIPDB ─────────────────────────────────────────────────────────────────

# Threat intelligence API key (free tier: 1000 checks/day).
# Sign up: https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# ── MaxMind GeoIP ─────────────────────────────────────────────────────────────

# Auto-update GeoIP databases. Sign up: https://www.maxmind.com/en/geolite2/signup
# Both values are required for auto-updates; without them, bundled DBs are used.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# ── UniFi Controller API (Optional) ──────────────────────────────────────────

# These env vars override the equivalent settings in the UI.
# When both UNIFI_HOST and UNIFI_API_KEY are set, the integration auto-enables.

# Controller URL (e.g. https://192.168.1.1 or https://10.10.10.1)
UNIFI_HOST=

# API key generated in: Network > Settings > Control Plane > Integrations
UNIFI_API_KEY=

# Site name for multi-site controllers (default: "default")
UNIFI_SITE=default

# Set to false for self-signed certificates (default: true)
UNIFI_VERIFY_SSL=true

# Seconds between client/device poll cycles
UNIFI_POLL_INTERVAL=300
